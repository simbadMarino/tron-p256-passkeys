# Point the mobile app at your apps/web backend.
# For local dev, use your machine's LAN IP (devices can't reach localhost on the host machine):
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# For a Vercel deployment, use the deployment URL:
#   EXPO_PUBLIC_API_URL=https://your-app.vercel.app

EXPO_PUBLIC_API_URL=http://localhost:3000

# RP ID must match what apps/web's Better Auth config uses.
# Hostname only — no scheme, no port.
EXPO_PUBLIC_RP_ID=localhost

# Set once you have an EAS project (optional for local dev)
# EXPO_PROJECT_ID=
